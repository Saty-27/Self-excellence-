# ---- dependencies ----
node_modules/
*/node_modules/

# ---- secrets ----
# Never commit real credentials. See backend/.env.example for the shape.
.env
*/.env
.env.local
.env.*.local

# ---- user uploads ----
# Site imagery (banners, course and teacher photos) IS tracked, so a clone
# renders correctly. Two categories are deliberately excluded:
#
#   lessons/   video files, several over GitHub's 100MB per-file hard limit
#   the rest   devotee payment receipts, enrolment documents and chat
#              attachments — private records that do not belong in a repo
backend/uploads/lessons/
backend/uploads/payment-receipts/
backend/uploads/pilgrimage-payments/
backend/uploads/trips-payment/
backend/uploads/books-payments/
backend/uploads/enrollment-requests/
backend/uploads/chat/

# ---- build output ----
dist/
build/
*.tsbuildinfo

# ---- logs & caches ----
*.log
logs/
backend/logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.vite/
.cache/

# ---- editor / OS ----
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
