# Copy to .env and fill in real values. Never commit the .env itself.

PORT=5055

# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/iskcon-lms

# Secret used to sign auth tokens. Use a long random string in production —
# anyone holding this can mint valid admin tokens.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated origins allowed to call the API
CLIENT_URL=http://localhost:5173,http://localhost:5174

# Optional: separate secret for OTP signing (falls back to JWT_SECRET)
# OTP_SECRET=

# Feature flag for Sacred Books module (Buy + Distribute)
# Set to 'false' to completely disable the Books feature and restore original behavior
BOOKS_ENABLED=true

# Google OAuth 2.0 Credentials (for 'Continue with Google')
# Client ID is public and shared with frontend; Client Secret is server-only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
